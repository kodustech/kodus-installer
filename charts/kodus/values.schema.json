{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Kodus Helm values",
  "type": "object",
  "definitions": {
    "emptyDir": {
      "type": "object",
      "properties": {
        "defaultSizeLimit": {
          "type": "string"
        },
        "sizeLimits": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extraEnvironment": {
      "type": "object",
      "properties": {
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
                "type": "object"
              }
            },
            "not": {
              "required": [
                "value",
                "valueFrom"
              ]
            }
          }
        },
        "extraEnvFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string"
              },
              "secretRef": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "optional": {
                    "type": "boolean"
                  }
                }
              },
              "configMapRef": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "optional": {
                    "type": "boolean"
                  }
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "secretRef"
                ]
              },
              {
                "required": [
                  "configMapRef"
                ]
              }
            ]
          }
        }
      }
    },
    "store": {
      "type": "object",
      "properties": {
        "bundled": { "$ref": "#/definitions/extraEnvironment" },
        "mode": {
          "enum": ["bundled", "external", "operator"],
          "description": "bundled (StatefulSet run by this chart) | external (managed/your own) | operator (CNPG/RabbitMQ/Mongo operator)"
        }
      },
      "required": ["mode"]
    }
  },
  "properties": {
    "emptyDir": { "$ref": "#/definitions/emptyDir" },
    "platform": {
      "enum": ["kubernetes", "openshift"]
    },
    "imageTag": {
      "type": "string",
      "description": "Kodus release tag applied to all app images + migrations when their own image.tag is empty."
    },
    "image": {
      "type": "object",
      "properties": {
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "autoGenerateSecrets": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "externalSecrets": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "store": { "type": "string" },
            "storeKind": { "enum": ["SecretStore", "ClusterSecretStore"] }
          }
        },
        "labels": { "type": "object" },
        "config": { "type": "object" },
        "secrets": { "type": "object" }
      }
    },
    "postgres": { "$ref": "#/definitions/store" },
    "mongodb": { "$ref": "#/definitions/store" },
    "rabbitmq": { "$ref": "#/definitions/store" },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/definitions/extraEnvironment"
          }
        ],
        "properties": {
          "emptyDir": {
            "$ref": "#/definitions/emptyDir"
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "allOf": [{ "$ref": "#/definitions/extraEnvironment" }],
      "properties": {
        "enabled": { "type": "boolean" },
        "emptyDir": { "$ref": "#/definitions/emptyDir" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "tls": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "route": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "scc": {
      "type": "object",
      "properties": { "create": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "autoscaling": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {
          "description": "Pods that must stay up during a voluntary disruption. An integer must leave room below each service's replica floor or the chart refuses to render (disruptionsAllowed would be 0); a percentage such as \"50%\" scales with the replica count instead.",
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^[0-9]{1,3}%$" }
          ]
        }
      }
    },
    "resourceQuota": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
