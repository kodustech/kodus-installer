.env
.env.backup
.env.e2e-backup.*

# Helm — vendored chart dependencies produced by `helm dependency build`
# Most dependency archives are generated locally. Keep the pinned kodus-common
# archive below in Git so Argo CD can render the Git chart without rebuilding it.
charts/*/charts/

# Test/debug artifacts — never commit these
.playwright-mcp/
kodus-*.png
*.tar.gz

# Git-based Argo CD source: ship the exact library used by this chart.
!/charts/kodus/charts/
/charts/kodus/charts/*
!/charts/kodus/charts/kodus-common-0.1.3.tgz
